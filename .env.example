# Copy to .env and replace with a unique, locally stored secret.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
FRONTEND_PORT=3000

# Optional SIEM delivery. Leave blank for offline-only operation.
SENTINELSOC_SPLUNK_HEC_URL=
SENTINELSOC_SPLUNK_HEC_TOKEN=
SENTINELSOC_ELASTICSEARCH_URL=
SENTINELSOC_ELASTICSEARCH_API_KEY=
SENTINELSOC_ELASTICSEARCH_INDEX=sentinelsoc-events
