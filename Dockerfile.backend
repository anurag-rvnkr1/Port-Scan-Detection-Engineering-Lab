FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN python -m pip install --no-cache-dir --requirement /app/requirements.lock \
    && addgroup --system --gid 10001 sentinelsoc \
    && adduser --system --uid 10001 --ingroup sentinelsoc --home /app sentinelsoc \
    && mkdir -p /app/data \
    && chown -R sentinelsoc:sentinelsoc /app

COPY --chown=sentinelsoc:sentinelsoc backend /app/backend
COPY --chown=sentinelsoc:sentinelsoc alembic.ini /app/alembic.ini

USER sentinelsoc
EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
